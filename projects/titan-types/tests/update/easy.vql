-- @schema: project
table_1.update(id) {
    if a > 0 && b < 0 {
        money = 0
        update_time = CURRENT_TIMESTAMP
    }
    else {
        money = -1
        update_time = CURRENT_TIMESTAMP
    }
}

let sql = `
UPDATE table_1
SET
	money = CASE
		WHEN a > 0 AND b < 0
			THEN 0
		ELSE
			-1
    END,
    update_time = CURRENT_TIMESTAMP
WHERE id = :id;
`
